# -------------------------------------------------------------
# Configuration Environnement — Clinique SantéPlus
# -------------------------------------------------------------

# Port d'écoute exposé sur l'hôte (défaut: 8000)
PORT=8000

# Django Core
SECRET_KEY=change-me-in-production-random-secret-key-super-secure
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de données PostgreSQL
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_secret_pass

# Données de démonstration automatiques (1 pour activer, 0 pour désactiver)
AUTO_SEED=1
